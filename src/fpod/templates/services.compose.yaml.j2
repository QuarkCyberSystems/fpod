# Generated by fpod {{ fpod_version }} — do not hand-edit.
# Regenerate via `fpod init --update` or `fpod services restart`.

networks:
  default:
    name: {{ network }}
    external: true

services:

  traefik:
    image: {{ services.traefik_image }}
    restart: unless-stopped
    # Rootless podman: socket is owned by host UID {{ uid }}. We keep that mapping
    # inside the container and run traefik as the same UID so it can read the socket.
    userns_mode: "keep-id:uid={{ uid }},gid={{ uid }}"
    user: "{{ uid }}:{{ uid }}"
    ports:
      - "{{ host_port }}:8080"
    volumes:
      - {{ podman_socket }}:/var/run/docker.sock:ro
    command:
      # Listen on :8080 inside the container — running as non-root we can't
      # bind privileged ports. Host port mapping decouples external choice.
      - --api.dashboard=true
      - --api.insecure=false
      - --providers.docker=true
      - --providers.docker.endpoint=unix:///var/run/docker.sock
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network={{ network }}
      - --entrypoints.web.address=:8080
      - --log.level=INFO
    labels:
      - traefik.enable=true
      - traefik.http.routers.dashboard.rule=Host(`traefik.{{ base_domain }}`)
      - traefik.http.routers.dashboard.service=api@internal
      - traefik.http.routers.dashboard.entrypoints=web

  mariadb:
    image: {{ services.mariadb_image }}
    restart: unless-stopped
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
    environment:
      MARIADB_ROOT_PASSWORD: "{{ mariadb_root_password }}"
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
      - mariadb-data:/var/lib/mysql

  redis-cache:
    image: {{ services.redis_image }}
    restart: unless-stopped

  redis-queue:
    image: {{ services.redis_image }}
    restart: unless-stopped

  redis-socketio:
    image: {{ services.redis_image }}
    restart: unless-stopped

  mailpit:
    image: {{ services.mailpit_image }}
    restart: unless-stopped
    environment:
      MP_MAX_MESSAGES: "5000"
      MP_DATABASE: /data/mailpit.db
      MP_SMTP_AUTH_ACCEPT_ANY: "1"
      MP_SMTP_AUTH_ALLOW_INSECURE: "1"
    volumes:
      - mailpit-data:/data
    labels:
      - traefik.enable=true
      - traefik.http.routers.mailpit.rule=Host(`mail.{{ base_domain }}`)
      - traefik.http.routers.mailpit.entrypoints=web
      - traefik.http.services.mailpit.loadbalancer.server.port=8025

  adminer:
    image: {{ services.adminer_image }}
    restart: unless-stopped
    environment:
      ADMINER_DEFAULT_SERVER: mariadb
    labels:
      - traefik.enable=true
      - traefik.http.routers.adminer.rule=Host(`db.{{ base_domain }}`)
      - traefik.http.routers.adminer.entrypoints=web
      - traefik.http.services.adminer.loadbalancer.server.port=8080

volumes:
  mariadb-data:
  mailpit-data:
