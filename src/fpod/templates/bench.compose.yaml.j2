# Generated by fpod {{ fpod_version }} — do not hand-edit.
# Bench: {{ name }}  Site: {{ site_name }}

networks:
  default:
    name: {{ network }}
    external: true

services:
  frappe:
    image: {{ frappe_image }}
    container_name: frappe-{{ name }}
    hostname: frappe-{{ name }}
    # on-failure (not unless-stopped): if bench init crashes, we want a few
    # retries then a hard stop so the failure is visible, not a tight loop.
    restart: on-failure:3
    userns_mode: "keep-id:uid=1000,gid=1000"
    working_dir: /workspace
    command: ["/workspace/entrypoint.sh"]
    # SteamOS host resolv.conf points at systemd-resolved (127.0.0.53) which
    # is unreachable from inside containers. Passing --dns makes aardvark
    # forward upstream queries to public resolvers; intra-network lookups
    # (mariadb, redis-cache) keep going through aardvark.
    dns:
      - 1.1.1.1
      - 8.8.8.8
    environment:
      SHELL: /bin/bash
      BENCH_BRANCH: "{{ branch }}"
      BENCH_PYTHON: "{{ python }}"
      MARIADB_ROOT_PASS: "{{ mariadb_root_password }}"
      ADMIN_PASS: "{{ admin_password }}"
      SITE_NAME: "{{ site_name }}"
      DEV_MODE: "{{ '1' if developer_mode else '0' }}"
    volumes:
      - {{ bench_dir }}:/workspace
    labels:
      - traefik.enable=true
      - traefik.docker.network={{ network }}
      # Web (port 8000 inside container)
      - traefik.http.routers.{{ name }}-web.rule=Host(`{{ site_name }}`)
      - traefik.http.routers.{{ name }}-web.service={{ name }}-web
      - traefik.http.routers.{{ name }}-web.entrypoints=web
      - traefik.http.services.{{ name }}-web.loadbalancer.server.port=8000
      # Socket.io (port 9000 inside container) — higher priority so it wins over the web rule.
      - traefik.http.routers.{{ name }}-sio.rule=Host(`{{ site_name }}`) && PathPrefix(`/socket.io`)
      - traefik.http.routers.{{ name }}-sio.service={{ name }}-sio
      - traefik.http.routers.{{ name }}-sio.entrypoints=web
      - traefik.http.routers.{{ name }}-sio.priority=100
      - traefik.http.services.{{ name }}-sio.loadbalancer.server.port=9000
