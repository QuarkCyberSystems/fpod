#!/bin/bash
# Generated by fpod — do not hand-edit.
# Runs once per container; the .fpod-initialized flag short-circuits re-init.

set -euo pipefail

cd /workspace

if [ ! -f .fpod-initialized ]; then
  # If a previous bench init crashed partway, frappe-bench/ exists but
  # is incomplete. bench init will refuse to overwrite it, so we clear it
  # ourselves before retrying. The flag file is our authority on "init done";
  # absent flag = whatever's there is salvageable scrap.
  if [ -d frappe-bench ]; then
    echo "==> fpod: clearing partial frappe-bench from a prior failed init"
    rm -rf frappe-bench
  fi

  echo "==> fpod: bench init starting (branch=${BENCH_BRANCH})"
  bench init \
    --skip-redis-config-generation \
    --frappe-branch "${BENCH_BRANCH}" \
    --python "${BENCH_PYTHON}" \
    frappe-bench

  cd frappe-bench
  echo "==> fpod: wiring bench to shared services"
  bench set-config -g db_host mariadb
  bench set-config -gp db_port 3306
  bench set-config -g redis_cache    redis://redis-cache:6379
  bench set-config -g redis_queue    redis://redis-queue:6379
  bench set-config -g redis_socketio redis://redis-socketio:6379
  # We use sidecar redis containers; drop the local ones from Procfile.
  sed -i '/redis/d' Procfile

  echo "==> fpod: creating site ${SITE_NAME}"
  bench new-site \
    --mariadb-root-password "${MARIADB_ROOT_PASS}" \
    --admin-password "${ADMIN_PASS}" \
    --mariadb-user-host-login-scope=% \
    "${SITE_NAME}"

  if [ "${DEV_MODE}" = "1" ]; then
    bench --site "${SITE_NAME}" set-config developer_mode 1
  fi
  bench use "${SITE_NAME}"

  cd /workspace
  touch .fpod-initialized
  echo "==> fpod: init complete"
fi

cd /workspace/frappe-bench
echo "==> fpod: starting bench"
exec bench start
